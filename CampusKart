<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>CampusKart - Student Shopping</title>
</head>
<body style="background-color: #ffffff; font-family: Arial, sans-serif; color: #000000; margin: 10px;">

  <div>


    <div style="text-align: center; border-bottom: 1px solid black;">
      <h1 style="margin: 5px 0; font-size: 22px;">CampusKart</h1>
      <p style="margin: 0 0 5px 0; font-size: 13px;">Official Student Store</p>
    </div>

    
    <div style="background-color: yellow; border-bottom: 1px solid black; text-align: center;">
      <p style="margin: 5px 0; font-weight: bold; font-size: 13px;">
        SPECIAL OFFER: Get 15% off your first order using code STUDENT15!
      </p>
    </div>

   
    <h2 style="font-size: 16px; margin: 10px 5px 5px 5px;">Available Products</h2>
    
    <div>
      
      

        <div style="width: 33%; border: 1px solid black; margin-right: 5px;">
        <h4 style="margin: 4px; font-size: 13px;">Scientific Calculator</h4>
        <p style="margin: 4px; font-size: 12px;">Category: Electronics</p>
        <p style="margin: 4px; font-size: 12px; font-weight: bold;">Price: 20.00</p>
        <p style="margin: 4px; font-size: 11px;">Status: In Stock</p>
      </div>
<br>
      
      <div style="width: 33%; border: 1px solid black; margin-right: 5px;">
        <h4 style="margin: 4px; font-size: 13px;">Notebook (Pack of 3)</h4>
        <p style="margin: 4px; font-size: 12px;">Category: Stationery</p>
        <p style="margin: 4px; font-size: 12px; font-weight: bold;">Price: 6.00</p>
        <p style="margin: 4px; font-size: 11px;">Status: In Stock</p>
      </div>
<br>
      
      <div style="width: 33%; border: 1px solid black;">
        <h4 style="margin: 4px; font-size: 13px;">Campus Hoodie</h4>
        <p style="margin: 4px; font-size: 12px;">Category: Clothing</p>
        <p style="margin: 4px; font-size: 12px; font-weight: bold;">Price: 25.00</p>
        <p style="margin: 4px; font-size: 11px;">Status: 4 Left</p>
      </div>
<br>
      <div style="width: 33%; border: 1px solid black;">
        <h4 style="margin: 4px; font-size: 13px;">Campus Hoodie</h4>
        <p style="margin: 4px; font-size: 12px;">Category: Clothing</p>
        <p style="margin: 4px; font-size: 12px; font-weight: bold;">Price: 25.00</p>
        <p style="margin: 4px; font-size: 11px;">Status: 4 Left</p>
      </div>
    </div>
  <br>

    
    <h2 style="font-size: 16px; border-top: 1px solid black; margin: 0 0 5px 0; padding-top: 5px;">Order Form</h2>

    <form action="#" method="post" style="margin: 5px;">
      
      <div style="margin-bottom: 5px;">
        <label style="display: block; font-size: 13px;">Full Name:</label>
        <input type="text" name="name" style="width: 100%; box-sizing: border-box; border: 1px solid black;" required>
      </div>

      <div style="margin-bottom: 5px;">
        <label style="display: block; font-size: 13px;">Student ID:</label>
        <input type="text" name="studentid" style="width: 100%; box-sizing: border-box; border: 1px solid black;" required>
      </div>

      <div style="margin-bottom: 5px;">
        <label style="display: block; font-size: 13px;">Select Product:</label>
        <select name="product" style="width: 100%; box-sizing: border-box; border: 1px solid black;" required>
          <option value="">-- Select an Item --</option>
          <option value="calculator">Scientific Calculator (20.00)</option>
          <option value="notebooks">Notebook Pack (6.00)</option>
          <option value="hoodie">Campus Hoodie (25.00)</option>
        </select>
      </div>

      <div style="margin-bottom: 5px;">
        <label style="display: block; font-size: 13px;">Quantity:</label>
        <input type="number" name="quantity" min="1" max="5" value="1" style="width: 100% border: 1px solid black;" required>
      </div>

      <div style="margin-bottom: 5px;">
        <label style="display: block; font-size: 13px;">Pickup Location:</label>
        <select name="location" style="width: 100%; box-sizing: border-box; border: 1px solid black;" required>
          <option value="hostel">Hostel Reception</option>
          <option value="library">Library Desk</option>
          <option value="cafeteria">Cafeteria</option>
        </select>
      </div>

      <div style="margin-bottom: 10px;">
        <label style="display: block; font-size: 13px;">Notes:</label>
        <textarea name="notes" rows="2" style="width: 100%; border: 1px solid black;"></textarea>
      </div>

      
      <button type="submit" style="background-color: lightgray; color: black; border: 1px solid black; width: 100%; font-size: 13px; cursor: pointer;">
        Submit Order
      </button>

    </form>

  </div>

</body>
</html>
